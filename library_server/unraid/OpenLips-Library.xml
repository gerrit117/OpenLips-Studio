<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>OpenLips-Library</Name>
  <Repository>ghcr.io/gerrit117/openlips-library:latest</Repository>
  <Registry>https://github.com/gerrit117/OpenLips-Studio/pkgs/container/openlips-library</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/gerrit117/OpenLips-Studio/issues</Support>
  <Project>https://github.com/gerrit117/OpenLips-Studio</Project>
  <Overview>OpenLips home-network library. One HTTP port, no login, TLS, FTP or discovery. Connect manually using http://UNRAID-IP:8765. The container prepares its dedicated appdata directory and runs the application as PUID/PGID. Compatible media encoding still requires Windows.</Overview>
  <Category>MediaApp:Other</Category>
  <WebUI>http://[IP]:8765/</WebUI>
  <Icon>https://raw.githubusercontent.com/gerrit117/OpenLips-Studio/main/library_server/static/logo-light.png</Icon>
  <ExtraParams></ExtraParams>
  <Config Name="Web port" Target="8765" Default="8765" Mode="tcp" Description="Open http://UNRAID-IP:8765." Type="Port" Display="always" Required="true" Mask="false">8765</Config>
  <Config Name="Library data" Target="/data" Default="/mnt/user/appdata/openlips-library" Mode="rw" Description="Dedicated persistent appdata directory. Existing library data is retained." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/openlips-library</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="Unraid nobody UID." Type="Variable" Display="always" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Unraid users GID." Type="Variable" Display="always" Required="true" Mask="false">100</Config>
</Container>
