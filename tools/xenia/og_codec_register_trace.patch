+// Research-only probes for OG Lips 0.0.0.20. No guest calls or guest writes.
+void LipsClockTrace(PPCContext* ctx, void* arg0, void* arg1) {
+  if (cvars::lips_clock_trace_path.empty()) return;
+  auto memory = static_cast<Memory*>(arg0);
+  auto phase = reinterpret_cast<uintptr_t>(arg1);
+  uint32_t object = uint32_t(ctx->r[phase == 1 ? 31 : 3]);
+  auto readable = [memory](uint32_t p, uint32_t bytes) {
+    if (p < 0x10000 || p > UINT32_MAX - bytes) return false;
+    auto heap = memory->LookupHeap(p);
+    return heap && (uint32_t(heap->QueryRangeAccess(p, p + bytes - 1)) & 1);
+  };
+  if (!readable(object, 0x338)) return;
+  static std::mutex mutex;
+  std::lock_guard<std::mutex> lock(mutex);
+  static std::ofstream output(cvars::lips_clock_trace_path);
+  static auto epoch = std::chrono::steady_clock::now();
+  struct Samples { double last = -1; unsigned count = 0; };
+  static std::map<uint32_t, Samples> samples;
+  double now = std::chrono::duration<double>(std::chrono::steady_clock::now() - epoch).count();
+  auto& sample = samples[object];
+  if (phase == 2 && (sample.count >= 180 || (sample.last >= 0 && now - sample.last < 0.5))) return;
+  if (phase == 2) { sample.last = now; ++sample.count; }
+  auto u = [memory](uint32_t p) { return xe::load_and_swap<uint32_t>(memory->TranslateVirtual(p)); };
+  auto f = [memory](uint32_t p) { return xe::load_and_swap<float>(memory->TranslateVirtual(p)); };
+  uint32_t audio = u(object + 0x22c), movie = u(object + 0x230);
+  output << fmt::format("host={:.6f} phase={} object={:08X} lr={:08X} f1={:.9f} started={} state16c={} clock={:.9f} previous={:.9f} frame={:.9f} elapsed_base={:.9f} audio={:08X} audio_state={} movie={:08X} movie_state={} audio_started={} movie_started={} music_delay={:.9f} media_base={:.9f} movie_delay={:.9f} conductor={:08X} tempo={:08X} index={:08X} sequences={:08X}/{}\n",
+      now, phase, object, uint32_t(ctx->lr), ctx->f[1], u(object + 0x168), u(object + 0x16c),
+      f(object + 0x278), f(object + 0x27c), f(object + 0x334), f(object + 0x25c),
+      audio, readable(audio, 12) ? int64_t(u(audio + 8)) : -1,
+      movie, readable(movie, 12) ? int64_t(u(movie + 8)) : -1,
+      u(object + 0x264), u(object + 0x268), f(object + 0x26c), f(object + 0x270), f(object + 0x274),
+      u(object + 0x18c), u(object + 0x190), u(object + 0x164), u(object + 0x64), u(object + 0x6c));
+  output.flush();
+}
