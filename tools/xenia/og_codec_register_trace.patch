+// Exact OG failure-queue site. The caller holds the failed path in r28.
+void LipsMediaFailureTrace(PPCContext* ctx, void* arg0, void* arg1) {
+  auto memory = static_cast<Memory*>(arg0);
+  auto readable = [memory](uint32_t p, uint32_t bytes) {
+    if (p < 0x10000 || p > UINT32_MAX - bytes) return false;
+    auto heap = memory->LookupHeap(p);
+    return heap && (uint32_t(heap->QueryRangeAccess(p, p + bytes - 1)) & 1);
+  };
+  uint32_t path_address = uint32_t(ctx->r[28]);
+  std::string path;
+  for (uint32_t i = 0; i < 512 && readable(path_address + i, 1); ++i) {
+    auto ch = *memory->TranslateVirtual(path_address + i);
+    if (!ch) break;
+    path += ch >= 32 && ch < 127 ? char(ch) : '?';
+  }
+  uint32_t owner = uint32_t(ctx->r[31]);
+  auto field = [&](uint32_t offset) {
+    return readable(owner + offset, 4)
+        ? xe::load_and_swap<uint32_t>(memory->TranslateVirtual(owner + offset))
+        : UINT32_MAX;
+  };
+  XELOGE("OG failed resource: path={} owner={:08X} request={:08X} override={:08X} lr={:08X}",
+         path, owner, field(0xc), field(0x10), uint32_t(ctx->lr));
+}
+
+void LipsCodecTrace(PPCContext* ctx, void* arg0, void* arg1) {
+  auto memory = static_cast<Memory*>(arg0);
+  auto site = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(arg1));
+  static std::mutex mutex;
+  std::lock_guard<std::mutex> lock(mutex);
+  static std::ofstream out(cvars::lips_codec_trace_path);
+  static std::map<uint32_t, unsigned> counts;
+  if (++counts[site] > 120) return;
+  out << fmt::format("site={:08X} hit={} lr={:08X} sp={:08X}",
+                     site, counts[site], uint32_t(ctx->lr), uint32_t(ctx->r[1]));
+  for (unsigned reg = 3; reg <= 8; ++reg)
+    out << fmt::format(" r{}={:08X}", reg, uint32_t(ctx->r[reg]));
+  if (site == 0x824B209C || site == 0x824BD2DC || site == 0x824BD2FC)
+    out << fmt::format(" f1={} f13={} f31={}", ctx->f[1], ctx->f[13], ctx->f[31]);
+  auto read = [memory](uint32_t p, uint32_t* result) {
+    if (p < 0x10000 || p > UINT32_MAX - 4) return false;
+    auto heap = memory->LookupHeap(p);
+    if (!heap || !(uint32_t(heap->QueryRangeAccess(p, p + 3)) & 1)) return false;
+    *result = xe::load_and_swap<uint32_t>(memory->TranslateVirtual(p));
+    return true;
+  };
+  if (site == 0x824FBE28) {
+    uint32_t stream = 0, format = 0, tag = 0;
+    uint32_t p = uint32_t(ctx->r[3]);
+    if (p <= UINT32_MAX - 8 && read(p + 4, &stream) && read(p + 8, &format) &&
+        format <= UINT32_MAX - 0x14 && read(format + 0x14, &tag))
+      out << fmt::format(" stream={} format={:08X} tag={:08X}", stream, format, tag);
+  }
+  out << '\n';
+  out.flush();
+}
